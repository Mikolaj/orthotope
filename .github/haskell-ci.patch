--- a/.github/workflows/haskell-ci.yml
+++ b/.github/workflows/haskell-ci.yml
@@ -30,9 +30,11 @@
     strategy:
       matrix:
         include:
-          - compiler: ghc-9.14.1
+          # GHC 9.14.2's second release candidate: 9.14.1 panics compiling the
+          # tests (https://gitlab.haskell.org/ghc/ghc/-/work_items/26682).
+          - compiler: ghc-9.14.1.20260916
             compilerKind: ghc
-            compilerVersion: 9.14.1
+            compilerVersion: 9.14.1.20260916
             setup-method: ghcup
             allow-failure: false
           - compiler: ghc-9.12.2
@@ -93,6 +95,7 @@
       - name: Install GHC (GHCup)
         if: matrix.setup-method == 'ghcup'
         run: |
+          "$HOME/.ghcup/bin/ghcup" config add-release-channel prereleases
           "$HOME/.ghcup/bin/ghcup" install ghc "$HCVER" || (cat "$HOME"/.ghcup/logs/*.* && false)
           HC=$("$HOME/.ghcup/bin/ghcup" whereis ghc "$HCVER")
           HCPKG=$(echo "$HC" | sed 's#ghc$#ghc-pkg#')
@@ -144,7 +147,7 @@
           EOF
           cat >> $CABAL_CONFIG <<EOF
           program-default-options
-            ghc-options: $GHCJOBS +RTS -M3G -RTS
+            ghc-options: $GHCJOBS +RTS -M16G -RTS
           EOF
           cat $CABAL_CONFIG
       - name: versions
@@ -223,6 +226,12 @@
       - name: tests
         run: |
           if [ $((HCNUMVER >= 90600)) -ne 0 ] ; then $CABAL v2-test $ARG_COMPILER $ARG_TESTS $ARG_BENCH all --test-show-details=direct ; fi
+      - name: benchmarks
+        run: |
+          if [ "$ARG_BENCH" = --enable-benchmarks ] ; then $CABAL v2-bench $ARG_COMPILER $ARG_TESTS $ARG_BENCH all ; fi
+      - name: tests with bounds checks
+        run: |
+          if [ "$ARG_TESTS" = --enable-tests ] ; then cd $GITHUB_WORKSPACE/source && $CABAL v2-test $ARG_COMPILER $ARG_TESTS --project-file=cabal.project.checks --builddir=dist-checks all --test-show-details=direct ; fi
       - name: cabal check
         run: |
           cd ${PKGDIR_orthotope} || false
