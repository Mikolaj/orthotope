-- The test suite with the extra bounds checks of vector and GHC:
--
--   cabal test --project-file=cabal.project.checks --builddir=dist-checks
--
-- vector checks its unsafe operations and its internal invariants, and
-- -fcheck-prim-bounds has every package built here check its array primops,
-- aborting the run; an access through a raw pointer, such as a Storable
-- vector's unsafeWith gives, goes unchecked.  The library's asserts, which an
-- optimised build drops, are kept as well.
packages: .
tests: True

constraints: vector +unsafechecks +internalchecks

package *
  ghc-options: -fcheck-prim-bounds

package orthotope
  ghc-options: -fno-ignore-asserts
