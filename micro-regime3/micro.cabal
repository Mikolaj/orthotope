cabal-version:      2.4
name:               micro
version:            0.1
build-type:         Simple

executable micro
    main-is:          Main.hs
    default-language: GHC2021
    -- -M2G turns a mistyped shape into a heap-overflow exception instead of
    -- an OOM: a full run peaks at 297 MiB in use (162 MB max residency), so
    -- the cap is ~7x the real high-water mark and cannot fire on a shape
    -- anyone means to add, while `[10000,10000,10]` would want 80GB.
    ghc-options:      -O1 -rtsopts "-with-rtsopts=-T -M2G"
    build-depends:
        base,
        vector,
        criterion,
        deepseq
