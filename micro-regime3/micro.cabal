cabal-version:      2.4
name:               micro
version:            0.1
build-type:         Simple

executable micro
    main-is:          Main.hs
    default-language: GHC2021
    -- -M8G turns a mistyped shape into a heap-overflow exception instead of
    -- an OOM: the cap is many times the real high-water mark, which every
    -- run now prints for itself from the -T stats below, so it cannot fire
    -- on a shape anyone means to add, while `[10000,10000,10]` would want
    -- 8GB for its input vector alone. -T is what those printed heap figures
    -- need.
    -- -fno-ignore-asserts because GHC drops `assert` at -O, and the size
    -- preconditions in Main.hs are asserted rather than dispatched on. Each
    -- is one test per call, not per element, so it cannot move a per-element
    -- figure; without the flag they would document without checking.
    -- -A32m -I0 -T -M8G is the line every recorded run since Run 13 carried on
    -- its recipe; since 2026-08-21 it is baked here instead, -A32m fixed for
    -- every process here and every horde-ad suite (README, Running it), and no
    -- recipe passes -with-rtsopts any more.
    ghc-options:      -O1 -fno-ignore-asserts -rtsopts
                      "-with-rtsopts=-A32m -I0 -T -M8G"
    build-depends:
        base,
        vector,
        criterion,
        criterion-measurement,
        deepseq

-- The element-type probe, whose own header says what it is and why it is not
-- part of the roster. An executable rather than a benchmark stanza, as micro
-- is and for the same two reasons: it dispatches modes from getArgs, so
-- `cabal run probe -- f32 --json et-f32.json` passes arguments straight
-- through where a benchmark stanza wants --benchmark-options for each; and a
-- benchmark stanza would put a multi-minute run one bare `cabal bench` away,
-- which is the trap horde-ad had to disarm with `buildable: False`.
executable probe
    main-is:          Probe.hs
    default-language: GHC2021
    -- The same regime as micro, since the point is to read these figures
    -- against that file's. No -M8G: the probe's largest payload is smaller
    -- than the main set's and nothing here can mistype a shape into an OOM,
    -- the six being copies that --lint holds to micro's own lists.
    ghc-options:      -O1 -fno-ignore-asserts -rtsopts
                      "-with-rtsopts=-A32m -I0 -T"
    build-depends:
        base,
        vector,
        criterion,
        deepseq
