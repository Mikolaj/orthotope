+-- PROBE EDIT 2026-08-18, UNCOMMITTED (small-pinned-churn goal 2, the -A
+-- probe): 'benchesCnnAt' at real-net channels, kernel 3x3, c_out 16,
+-- n_hidden 64, monomorphized at 24x24. A probe-local objective rather
+-- than a generalized 'cnnObjective', so the shared test helper and the
+-- printed-AST test stay untouched. The new groups enter no numbered
+-- property; remove this block, or formalize it together with the
+-- property checker's partition, before committing anything here.
+cnnObjectiveBig
+  :: ADReady target
+  => Concrete (TKS '[7, 1, 24, 24] Double)
+  -> MnistCnnShaped2.ADCnnMnistParametersShaped target 24 24 2 2 16 64 Double
+  -> target (TKS '[SizeMnistLabel, 7] Double)
+cnnObjectiveBig glyph (params1, params2, paramsDense, paramsReadout) =
+  MnistCnnShaped2.convMnistTwoS
+    (SNat @2) (SNat @2) (SNat @24) (SNat @24) (SNat @16) (SNat @64) (SNat @7)
+    (sconcrete $ unConcrete glyph)
+    params1 params2 paramsDense paramsReadout
+
+benchesCnnBig24 :: IO [Benchmark]
+benchesCnnBig24 = do
+  let (valsInit, seed2) =
+        randomValue @(MnistCnnShaped2.ADCnnMnistParametersShaped
+                        Concrete 24 24 2 2 16 64 Double)
+                    0.4 (mkStdGen 44)
+      (arrGlyph, seed3) =
+        randomValue @(Concrete (TKS '[7, 1, 24, 24] Double)) 0.5 seed2
+      (arrDt, _) =
+        randomValue @(Concrete (TKS '[SizeMnistLabel, 7] Double)) 0.5 seed3
+      valsInitT = toTarget @Concrete valsInit
+      forceCnnGrad ((k1, b1), (k2, b2), (wd, bd), (wr, br)) =
+        forceGrad k1 + forceGrad b1 + forceGrad k2 + forceGrad b2
+        + forceGrad wd + forceGrad bd + forceGrad wr + forceGrad br
+      f = cnnObjectiveBig arrGlyph
+      artifactRaw = vjpArtifact f valsInit
+      artifact = simplifyArtifactRev artifactRaw
+  _ <- evaluate artifactRaw
+  _ <- evaluate artifact
+  return
+    [ bench "S-fullpipe-honest" $ whnf
+        (\glyph -> forceCnnGrad $ vjp (cnnObjectiveBig glyph) valsInit arrDt)
+        arrGlyph
+    , bench "S-artifact" $ whnf
+        (simplifyArtifactRev . vjpArtifact f) valsInit
+    , bench "S-exec" $ whnf
+        (\dt -> forceCnnGrad
+                  (vjpInterpretArtifact artifact valsInitT dt
+                   :: MnistCnnShaped2.ADCnnMnistParametersShaped
+                        Concrete 24 24 2 2 16 64 Double)) arrDt
+    , bench "S-exec-raw" $ whnf
+        (\dt -> forceCnnGrad
+                  (vjpInterpretArtifact artifactRaw valsInitT dt
+                   :: MnistCnnShaped2.ADCnnMnistParametersShaped
+                        Concrete 24 24 2 2 16 64 Double)) arrDt
+    ]
+
