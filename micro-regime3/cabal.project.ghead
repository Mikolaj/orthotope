-- The GHC HEAD project file since 2026-09-19: the minimum that
-- compiles here, found by dropping one directive at a time from
-- cabal.project.ghead.2026-07-25 and building micro after each
-- (log-minimize.txt). It has no freeze, so its plan is not that file's,
-- aeson 2.3.2.0 against 2.2.5.0; the index-state, which no build needs, is
-- what keeps it from floating.
--
-- Each constraint and allow-newer entry is named by the failure it
-- prevents. Without `base`, `ghc-prim` or `ghc-bignum` there is no plan
-- at all, vector, vector-stream and hashable bounding those three boot
-- libraries below what this compiler ships. `template-haskell` and
-- `containers` can be replaced from hackage, and the replacements fail to
-- build: template-haskell-2.22.0.0 with GHC-83865, binary-0.8.9.3 under
-- containers 0.7 with GHC-76037. hashable 1.5.1.0 fails with GHC-87110 on
-- `GHC.Num.BigNat`, its cabal file not declaring the ghc-bignum it imports;
-- data-default-class-0.2.0.0 fails with GHC-49917 on the implicit import of
-- `GHC.Essentials`, and the flag is scoped to that package alone.
--
-- The path below names a moving target: a HEAD that moves is a different
-- compiler, so read the version out of the binary.
packages: .
with-compiler: /home/mikolaj/r/horde-ad/ghc/_build/stage1/bin/ghc
index-state: hackage.haskell.org 2026-09-19T16:13:55Z

allow-newer: base, ghc-prim, ghc-bignum, template-haskell, containers

constraints: hashable ==1.5.0.0

package data-default-class
  ghc-options: -frebindable-known-names
