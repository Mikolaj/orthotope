github-patches: .github/haskell-ci.patch
timeout-minutes: 180
-- The tests need base 4.18, of GHC 9.6 (orthotope.cabal).
tests: >=9.6
-- The benchmark runs as a smoke test of one row a family, its timings on CI
-- measuring nothing (.github/haskell-ci.patch).  GHC 8.10.7 and 9.4.8 build
-- the library alone: they were the first to run the GitHub runner out of
-- memory compiling the test suite (8.10.7 at DynamicGTest, 9.4.8 at
-- RankedGTest with bounds checks), even with a heap of 16 GB and three hours,
-- and kept to the library, failing first, they raise no false alarms as the
-- code grows.
benchmarks: >=9.0 && <9.4 || >=9.6
