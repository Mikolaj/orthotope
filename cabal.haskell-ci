github-patches: .github/haskell-ci.patch
timeout-minutes: 180
-- GHC 8.10.7 and 9.4.8 build the library but no tests or benchmarks:
-- they were the first of all the GHCs to run the GitHub runner out
-- of memory compiling the test suite (8.10.7 at DynamicGTest, 9.4.8
-- at RankedGTest in the build with bounds checks), GHC being killed
-- even with a heap of 16 GB and three hours, where pr-mikolaj-bugfixes
-- compiles under both.  That was under harsher conditions than now, the
-- strided fill INLINE as well as the route, but the two still build the
-- library alone, so that, failing first, they raise no false alarms as
-- the code grows.
tests: >=9.0 && <9.4 || >=9.6
benchmarks: >=9.0 && <9.4 || >=9.6
-- GHC 9.2.8 builds the tests but runs none: its Storable and Unboxed
-- convert and convertE allocate 32.01 bytes an element over boxed, past
-- BenchViewsTest's bound of 32, where 9.12.4's allocate 16.01.
run-tests: >=9.0 && <9.2 || >=9.6
